// Mission Control: на затемнённых обоях сверху ряд рабочих столов, ниже все окна плитками с названиями. Позиции и
// размеры плиток считает Rust (`mission.rs`), здесь только вид и щелчки: окно, рабочий стол, «новый стол», фон.
import { Palette, Glyph, Icons, AppPlaceholder } from "common.slint";

export struct MissionTile {
    image: image,
    has-image: bool,
    icon: image,
    has-icon: bool,
    title: string,
    x: length,
    y: length,
    w: length,
    h: length,
}

export struct DesktopTile {
    name: string,
    current: bool,
}

export component MissionControl inherits Window {
    background: transparent;
    default-font-family: "Segoe UI Variable Display";

    in property <[MissionTile]> tiles;
    in property <[DesktopTile]> desktops;
    /// Сколько места слева у ряда столов: он центруется по ширине окна.
    in property <bool> can-add-desktop: true;
    callback picked(int);
    callback desktop-picked(int);
    callback desktop-added();
    callback background-clicked();

    // Щелчок мимо плиток закрывает обзор.
    TouchArea {
        clicked => {
            root.background-clicked();
        }
    }

    // Ряд рабочих столов.
    HorizontalLayout {
        y: 22px;
        height: 78px;
        alignment: center;
        spacing: 12px;

        for d[i] in root.desktops: Rectangle {
            width: 132px;
            height: 78px;
            border-radius: 12px;
            background: d.current ? #ffffff30 : desk-area.pressed ? #ffffff2a : desk-area.has-hover ? #ffffff22 : #ffffff16;
            border-width: d.current ? 2px : 1px;
            border-color: d.current ? Palette.accent : #ffffff30;
            animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

            Text {
                width: parent.width;
                height: parent.height;
                text: d.name;
                color: Palette.text;
                font-size: 13px;
                font-weight: d.current ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            desk-area := TouchArea {
                clicked => {
                    root.desktop-picked(i);
                }
            }
        }

        if root.can-add-desktop: Rectangle {
            width: 78px;
            height: 78px;
            border-radius: 12px;
            background: add-area.pressed ? #ffffff2a : add-area.has-hover ? #ffffff22 : #ffffff12;
            animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

            Glyph {
                size: 24px;
                tint: Palette.text;
                commands: Icons.plus;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            add-area := TouchArea {
                clicked => {
                    root.desktop-added();
                }
            }
        }
    }

    for t[i] in root.tiles: Rectangle {
        x: t.x;
        y: t.y;
        width: t.w;
        height: t.h;

        // Миниатюра окна в рамке; наведённая подсвечивается цветом системы.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height - 30px;
            border-radius: 10px;
            background: #1c1d22;
            border-width: tile-area.has-hover ? 3px : 1px;
            border-color: tile-area.has-hover ? Palette.accent : #ffffff30;
            clip: true;

            if t.has-image: Image {
                source: t.image;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }

            if !t.has-image: Rectangle {
                if t.has-icon: Image {
                    source: t.icon;
                    width: min(parent.width, parent.height) * 0.4;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }

                if !t.has-icon: AppPlaceholder {
                    size: min(parent.width, parent.height) * 0.36;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Значок приложения и название под миниатюрой.
        if t.has-icon: Image {
            source: t.icon;
            x: max(0px, (parent.width - 20px - 8px - label.preferred-width) / 2);
            y: parent.height - 24px;
            width: 20px;
            height: 20px;
            image-fit: contain;
        }

        label := Text {
            x: (t.has-icon ? max(0px, (parent.width - 28px - self.preferred-width) / 2) + 28px : 0px);
            y: parent.height - 26px;
            width: min(self.preferred-width, parent.width - (t.has-icon ? 28px : 0px));
            height: 24px;
            text: t.title;
            color: Palette.text;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }

        tile-area := TouchArea {
            height: parent.height - 30px;
            clicked => {
                root.picked(i);
            }
        }
    }
}
