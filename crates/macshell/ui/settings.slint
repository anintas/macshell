// Окно настроек macshell: слева вкладки, справа строки. Строка это выключатель, переключатель «по кругу» или ряд
// цветов; что в каких вкладках и как применяется, решает Rust (`settings.rs`). Размер 720 x 500.
import { Palette, Glyph, Icons } from "common.slint";

/// Строка настроек. `kind`: 0 выключатель, 1 выбор по кругу (`options`, `value` номер), 2 цвета (`colors`, `value`
/// номер или -1), 3 подзаголовок. `hint` вторая строка мелким шрифтом.
export struct SetRow {
    label: string,
    hint: string,
    kind: int,
    value: int,
    options: [string],
    colors: [color],
}

component Switch inherits Rectangle {
    in property <bool> on;
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? Palette.accent : #ffffff2e;
    animate background { duration: Palette.animations-enabled ? 140ms : 0ms; easing: ease-out; }

    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: white;
        animate x { duration: Palette.animations-enabled ? 140ms : 0ms; easing: ease-out; }
    }
}

export component Settings inherits Window {
    background: transparent;
    preferred-width: 720px;
    preferred-height: 500px;
    default-font-family: "Segoe UI Variable Display";

    in property <[string]> tabs;
    in property <int> tab;
    in property <[SetRow]> rows;
    in property <string> note;
    in-out property <int> choice-row: -1;
    in-out property <int> choice-index: 0;
    in-out property <int> keyboard-row: -1;
    in property <image> glass-preview;
    in property <bool> preview-available: false;
    callback tab-selected(int);
    callback changed(int, int);
    callback dismiss();

    // Вкладки.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 180px;
        height: parent.height;
        border-radius: 18px;
        background: #ffffff10;

        Text {
            x: 18px;
            y: 14px;
            width: parent.width - 36px;
            height: 24px;
            text: "Настройки";
            color: Palette.text;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
        }

        for name[i] in root.tabs: Rectangle {
            x: 8px;
            y: 52px + 38px * i;
            width: parent.width - 16px;
            height: 34px;
            border-radius: 11px;
            background: i == root.tab ? Palette.accent.mix(#000000, 0.4) : tab-area.pressed ? #ffffff26 : tab-area.has-hover ? #ffffff18 : #ffffff00;
            animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

            Text {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                text: name;
                color: i == root.tab ? white : Palette.text;
                font-size: 13px;
                font-weight: i == root.tab ? 600 : 400;
                vertical-alignment: center;
            }

            tab-area := TouchArea {
                clicked => {
                    root.tab-selected(i);
                }
            }
        }

        Text {
            x: 14px;
            y: parent.height - 56px;
            width: parent.width - 28px;
            height: 44px;
            text: root.note;
            color: Palette.secondary;
            font-size: 11px;
            wrap: word-wrap;
            vertical-alignment: bottom;
        }
    }

    Rectangle {
        x: 184px;
        y: 8px;
        width: parent.width - 192px;
        height: parent.height - 16px;
        border-radius: 14px;
        background: #111318b8;
    }

    Text {
        x: 200px;
        y: 15px;
        width: parent.width - 260px;
        height: 30px;
        text: root.tabs[root.tab];
        color: Palette.text;
        font-size: 20px;
        font-weight: 700;
        vertical-alignment: center;
    }

    // Закрыть.
    Rectangle {
        x: parent.width - 44px;
        y: 14px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: close-area.pressed ? #ffffff38 : close-area.has-hover ? #ffffff24 : #ffffff10;
        animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

        Glyph {
            size: 14px;
            tint: Palette.text;
            commands: Icons.close;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        close-area := TouchArea {
            clicked => {
                root.dismiss();
            }
        }
    }

    // Строки текущей вкладки.
    for row[i] in root.rows: Rectangle {
        x: 196px;
        y: 56px + 40px * i;
        width: parent.width - 196px - 24px;
        height: 38px;
        border-radius: 8px;
        background: i == root.keyboard-row ? #ffffff19 : #ffffff00;

        if row.kind == 3: Text {
            y: 8px;
            width: parent.width;
            height: 22px;
            text: row.label;
            color: Palette.secondary;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }

        if row.kind != 3: Text {
            x: 4px;
            y: row.hint == "" ? 0px : 3px;
            width: parent.width - (row.kind == 0 ? 64px : row.kind == 1 || row.kind == 4 ? 224px : 26px * row.colors.length + 16px);
            height: row.hint == "" ? parent.height : 20px;
            text: row.label;
            color: Palette.text;
            font-size: 14px;
            overflow: elide;
            vertical-alignment: center;
        }

        if row.kind != 3 && row.hint != "": Text {
            x: 4px;
            y: 22px;
            width: parent.width - (row.kind == 0 ? 64px : row.kind == 1 || row.kind == 4 ? 224px : 26px * row.colors.length + 16px);
            height: 14px;
            text: row.hint;
            color: Palette.secondary;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }

        if row.kind == 0: Switch {
            x: parent.width - self.width - 4px;
            y: 6px;
            on: row.value == 1;
        }

        if row.kind == 1: Rectangle {
            x: parent.width - 212px;
            y: 4px;
            width: 208px;
            height: 30px;
            border-radius: 15px;
            background: cycle-area.pressed ? #ffffff2e : cycle-area.has-hover ? #ffffff22 : #ffffff14;
            animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

            Text {
                width: parent.width;
                height: parent.height;
                text: row.options[row.value];
                color: Palette.text;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            cycle-area := TouchArea {
                clicked => {
                    root.choice-row = i;
                    root.choice-index = row.value;
                }
            }
        }

        if row.kind == 4: Rectangle {
            x: parent.width - 208px;
            y: 5px;
            width: 204px;
            height: 28px;
            Rectangle {
                x: 0px;
                y: 11px;
                width: 155px;
                height: 6px;
                border-radius: 3px;
                background: #ffffff38;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * (row.value - 10) / 75;
                    height: parent.height;
                    border-radius: 3px;
                    background: Palette.caret;
                }
            }
            Rectangle {
                x: 146px * (row.value - 10) / 75;
                y: 5px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: white;
            }
            Text {
                x: 166px;
                width: 38px;
                height: parent.height;
                text: row.value + "%";
                color: Palette.text;
                font-size: 12px;
                vertical-alignment: center;
            }
            TouchArea {
                x: 0px;
                width: 164px;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.changed(i, Math.round(10 + 75 * clamp(self.mouse-x / self.width, 0, 1)));
                    }
                }
                moved => {
                    if self.pressed { root.changed(i, Math.round(10 + 75 * clamp(self.mouse-x / self.width, 0, 1))); }
                }
            }
        }

        for c[j] in row.colors: Rectangle {
            x: parent.width - 4px - 26px * (row.colors.length - j);
            y: 6px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: c;
            border-width: j == row.value ? 2px : 1px;
            border-color: j == row.value ? white : #ffffff40;

            TouchArea {
                clicked => {
                    root.changed(i, j);
                }
            }
        }

        if row.kind == 0: TouchArea {
            clicked => {
                root.changed(i, row.value == 1 ? 0 : 1);
            }
        }
    }

    if root.tab == 5 && root.preview-available: Rectangle {
        x: 200px;
        y: 306px;
        width: 480px;
        height: 96px;
        border-radius: 16px;
        clip: true;
        Image { source: root.glass-preview; width: parent.width; height: parent.height; image-fit: cover; }
        Text { x: 20px; y: 17px; text: "Предпросмотр"; color: white; font-size: 15px; font-weight: 600; }
        Text { x: 20px; y: 45px; text: "Меню на текущих обоях"; color: #ffffffc9; font-size: 12px; }
    }

    if root.choice-row >= 0: Rectangle {
        x: parent.width - 256px;
        y: 90px;
        width: 232px;
        height: root.rows[root.choice-row].options.length * 34px + 16px;
        border-radius: 14px;
        background: #292c33;
        border-width: 1px;
        border-color: #ffffff38;

        for option[j] in root.rows[root.choice-row].options: Rectangle {
            x: 6px;
            y: 8px + j * 34px;
            width: parent.width - 12px;
            height: 32px;
            border-radius: 8px;
            background: j == root.choice-index ? #ffffff28 : option-area.has-hover ? #ffffff1a : #ffffff00;
            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: (j == root.rows[root.choice-row].value ? "✓  " : "     ") + option;
                color: Palette.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            option-area := TouchArea {
                clicked => {
                    root.changed(root.choice-row, j);
                    root.choice-row = -1;
                }
            }
        }
    }
}
