// Окно значков трея, как всплывающее окно Windows: сетка по 4 в ряд, внизу подсказка под курсором.
// Плитка 44 px, радиус 12 = радиус окна 20 минус отступ 8 (концентрично).
import { Icons, Palette, Glyph, TrayItem, AppPlaceholder } from "common.slint";

component Tile inherits Rectangle {
    in property <TrayItem> item;
    callback clicked();
    callback right-clicked();
    callback pin-toggled();
    callback hide-toggled();
    callback hovered();
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: area.pressed ? #ffffff38 : area.has-hover ? #ffffff26 : #ffffff00;
    animate background { duration: Palette.animations-enabled ? 120ms : 0ms; easing: ease-out; }

    Image {
        source: root.item.icon;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        opacity: (root.item.limited || root.item.hidden) ? 0.5 : 1;
    }

    if root.item.icon.width == 0: AppPlaceholder {
        size: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: (root.item.limited || root.item.hidden) ? 0.5 : 1;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                root.hovered();
            }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.right-clicked();
            }
        }
    }

    // Булавка: видна под курсором, у закреплённых всегда.
    Rectangle {
        width: 18px;
        height: 18px;
        x: parent.width - self.width - 2px;
        y: 2px;
        border-radius: 9px;
        background: pin-area.has-hover ? #ffffff40 : #00000059;
        opacity: (area.has-hover || pin-area.has-hover || root.item.pinned) ? 1 : 0;
        animate opacity { duration: Palette.animations-enabled ? 120ms : 0ms; easing: ease-out; }
        visible: !root.item.limited;

        Glyph {
            commands: root.item.pinned ? Icons.pin-fill : Icons.pin;
            size: 11px;
            tint: root.item.pinned ? Palette.caret : Palette.text;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        pin-area := TouchArea {
            clicked => {
                root.pin-toggled();
            }
        }
    }

    // Убрать значок из окна (у спрятанных: вернуть). Виден под курсором, слева сверху.
    Rectangle {
        width: 18px;
        height: 18px;
        x: 2px;
        y: 2px;
        border-radius: 9px;
        background: hide-area.has-hover ? #ffffff40 : #00000059;
        opacity: (area.has-hover || hide-area.has-hover) ? 1 : 0;
        animate opacity { duration: Palette.animations-enabled ? 120ms : 0ms; easing: ease-out; }

        Glyph {
            commands: root.item.hidden ? Icons.plus : Icons.close;
            size: 10px;
            tint: Palette.text;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        hide-area := TouchArea {
            clicked => {
                root.hide-toggled();
            }
        }
    }
}

export component TrayFlyout inherits Window {
    background: transparent;
    preferred-width: 204px;
    preferred-height: 94px;
    default-font-family: "Segoe UI Variable Display";

    in property <[TrayItem]> items;
    in-out property <string> hover-name;
    in-out property <string> hover-tip;
    callback clicked(int);
    callback right-clicked(int);
    callback pin-toggled(int);
    callback hide-toggled(int);
    callback reveal-toggled();
    /// Сколько значков убрано из окна; 0 скрывает кнопку внизу.
    in property <int> hidden-count: 0;
    in property <bool> show-hidden: false;

    for item[i] in root.items: Tile {
        x: 8px + Math.mod(i, 4) * 48px;
        y: 8px + Math.floor(i / 4) * 48px;
        item: item;
        clicked => {
            root.clicked(i);
        }
        right-clicked => {
            root.right-clicked(i);
        }
        pin-toggled => {
            root.pin-toggled(i);
        }
        hide-toggled => {
            root.hide-toggled(i);
        }
        hovered => {
            root.hover-name = item.name;
            root.hover-tip = item.tip;
        }
    }

    if root.items.length == 0: Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 44px;
        text: "Нет значков";
        color: Palette.secondary;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Под сеткой: название приложения и первая строка его подсказки.
    // Кнопка справа внизу: показать убранные значки (приглушённо, с кнопкой «вернуть») или снова спрятать.
    if root.hidden-count > 0: Rectangle {
        width: reveal-label.preferred-width + 16px;
        height: 20px;
        x: parent.width - self.width - 8px;
        y: parent.height - 38px;
        border-radius: 10px;
        background: reveal-area.pressed ? #ffffff30 : reveal-area.has-hover ? #ffffff1c : #ffffff00;
        animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

        reveal-label := Text {
            x: 8px;
            height: parent.height;
            text: root.show-hidden ? "Скрыть убранные" : "Убрано: " + root.hidden-count;
            color: Palette.secondary;
            font-size: 11px;
            vertical-alignment: center;
        }

        reveal-area := TouchArea {
            clicked => {
                root.reveal-toggled();
            }
        }
    }

    Text {
        x: 12px;
        y: parent.height - 38px;
        width: parent.width - (root.hidden-count > 0 ? 112px : 24px);
        height: 17px;
        text: root.hover-name;
        color: Palette.text;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 12px;
        y: parent.height - 22px;
        width: parent.width - 24px;
        height: 15px;
        text: root.hover-tip;
        color: Palette.secondary;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
    }
}
