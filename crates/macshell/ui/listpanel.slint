// Страница со списком: шапка с выключателем, строки (устройства Bluetooth, сети Wi-Fi), ссылка на параметры. Одна и
// та же панель стоит отдельной страницей в Центре управления (со стрелкой «назад») и самостоятельным окном под
// значком в строке меню. Ширина задаётся окном (316), высота считается здесь: 144 + тело, тело это 22 + 44 на
// строку или 100, когда показывать нечего. Rust считает ту же высоту в `list_height` (popups.rs).
import { Palette, Glyph, Icons } from "common.slint";

/// Строка списка. `kind`: 0 общее, 1 наушники, 2 колонка, 3 мышь, 4 клавиатура, 5 геймпад, 6 телефон, 7 часы,
/// 8 сеть Wi-Fi, 9 защищённая сеть. `action`: надпись кнопки справа («Подключить») или пусто, если кнопки нет.
export struct ListRow {
    name: string,
    status: string,
    connected: bool,
    kind: int,
    action: string,
}

component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    in property <bool> keyboard-focus: false;
    callback toggled();
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? Palette.accent : #ffffff2e;
    border-width: root.keyboard-focus ? 2px : 0px;
    border-color: white;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Palette.animations-enabled ? 140ms : 0ms; easing: ease-out; }

    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: white;
        animate x { duration: Palette.animations-enabled ? 140ms : 0ms; easing: ease-out; }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled();
        }
    }
}

component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <bool> keyboard-focus: false;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: area.pressed ? #ffffff38 : area.has-hover ? #ffffff26 : #ffffff14;
    border-width: root.keyboard-focus ? 2px : 0px;
    border-color: white;
    animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

    Glyph {
        size: 16px;
        tint: Palette.text;
        commands: root.icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component ListPanel inherits Rectangle {
    in property <string> title;
    /// Значок в круге шапки (контур из `Icons`).
    in property <string> icon;
    in property <string> list-title: "Устройства";
    in property <bool> on;
    /// Есть ли в компьютере само радио.
    in property <bool> available: true;
    in property <string> state-text;
    in property <[ListRow]> rows;
    /// Что написать вместо списка, когда его нет (радио выключено, нет адаптера, ничего не найдено).
    in property <string> empty-text;
    in property <string> footer-text;
    in property <bool> back-visible;
    in property <int> keyboard-focus: -1;
    /// Не ниже этой высоты тело панели: окно имеет постоянный размер, а панель при смене списка не должна «прыгать».
    in property <length> min-body-h: 0px;
    callback back();
    callback toggled();
    callback row-clicked(int);
    callback settings();

    property <bool> has-rows: root.on && root.rows.length > 0;
    property <length> body-h: max(root.min-body-h, root.has-rows ? 22px + 44px * root.rows.length : 100px);
    out property <length> panel-height: 144px + root.body-h;

    function device-icon(kind: int) -> string {
        if kind == 1 {
            return Icons.headphones;
        }
        if kind == 2 {
            return Icons.speaker;
        }
        if kind == 3 {
            return Icons.mouse;
        }
        if kind == 4 {
            return Icons.keyboard;
        }
        if kind == 5 {
            return Icons.gamepad;
        }
        if kind == 6 {
            return Icons.phone;
        }
        if kind == 7 {
            return Icons.watch;
        }
        if kind == 8 || kind == 9 {
            return Icons.wifi;
        }
        return Icons.bluetooth;
    }

    // Шапка.
    Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: 56px;
        border-radius: 18px;
        background: #ffffff14;

        if root.back-visible: RoundButton {
            x: 10px;
            y: 12px;
            icon: Icons.chevron-left;
            keyboard-focus: root.keyboard-focus == 0;
            clicked => {
                root.back();
            }
        }

        Rectangle {
            x: root.back-visible ? 50px : 10px;
            y: 11px;
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: root.on ? Palette.accent : #ffffff26;
            animate background { duration: Palette.animations-enabled ? 140ms : 0ms; easing: ease-out; }

            Glyph {
                size: 18px;
                tint: white;
                commands: root.icon;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            x: (root.back-visible ? 50px : 10px) + 44px;
            y: 9px;
            width: parent.width - self.x - 64px;
            height: 20px;
            text: root.title;
            color: Palette.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            x: (root.back-visible ? 50px : 10px) + 44px;
            y: 29px;
            width: parent.width - self.x - 64px;
            height: 18px;
            text: root.state-text;
            color: Palette.secondary;
            font-size: 11px;
            vertical-alignment: center;
        }

        Toggle {
            x: parent.width - self.width - 14px;
            y: 15px;
            on: root.on;
            enabled: root.available;
            keyboard-focus: root.keyboard-focus == 1;
            toggled => {
                root.toggled();
            }
        }
    }

    // Устройства.
    if root.has-rows: Text {
        x: 26px;
        y: 80px;
        width: parent.width - 52px;
        height: 22px;
        text: root.list-title;
        color: Palette.secondary;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }

    if root.has-rows: Rectangle {
        x: 12px;
        y: 102px;
        width: parent.width - 24px;
        height: 44px * root.rows.length;
        border-radius: 18px;
        background: #ffffff14;
        clip: true;

        for row[i] in root.rows: Rectangle {
            y: 44px * i;
            height: 44px;
            background: row-area.pressed ? #ffffff26 : row-area.has-hover ? #ffffff14 : #ffffff00;
            border-width: root.keyboard-focus == i + 2 ? 2px : 0px;
            border-color: white;
            animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

            Rectangle {
                x: 10px;
                y: 6px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: row.connected ? Palette.accent : #ffffff26;
                animate background { duration: Palette.animations-enabled ? 140ms : 0ms; easing: ease-out; }

                Glyph {
                    size: 17px;
                    tint: white;
                    commands: root.device-icon(row.kind);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Text {
                x: 52px;
                y: 5px;
                width: parent.width - 52px - (row.action == "" ? 12px : 100px);
                height: 18px;
                text: row.name;
                color: Palette.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                x: 52px;
                y: 23px;
                width: parent.width - 52px - (row.action == "" ? 12px : 100px);
                height: 15px;
                text: row.status;
                color: row.connected ? Palette.caret : Palette.secondary;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }

            if row.kind == 9 && row.action == "": Glyph {
                size: 13px;
                tint: Palette.secondary;
                commands: Icons.lock;
                x: parent.width - self.width - 14px;
                y: (parent.height - self.height) / 2;
            }

            if row.action != "": Rectangle {
                x: parent.width - self.width - 10px;
                y: 9px;
                width: 82px;
                height: 26px;
                border-radius: 13px;
                background: row-area.pressed ? #ffffff40 : row-area.has-hover ? #ffffff2e : #ffffff1f;
                animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

                Text {
                    text: row.action;
                    color: Palette.text;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if i > 0: Rectangle {
                x: 52px;
                y: 0px;
                width: parent.width - 52px - 12px;
                height: 1px;
                background: Palette.hairline;
            }

            row-area := TouchArea {
                clicked => {
                    root.row-clicked(i);
                }
            }
        }
    }

    // Пусто: радио выключено, нет адаптера или нет сопряжённых устройств.
    if !root.has-rows: Rectangle {
        x: 12px;
        y: 80px;
        width: parent.width - 24px;
        height: root.body-h;
        border-radius: 18px;
        background: #ffffff14;

        Glyph {
            size: 30px;
            tint: Palette.secondary;
            commands: root.icon;
            x: (parent.width - self.width) / 2;
            y: (parent.height - 76px) / 2;
        }

        Text {
            x: 12px;
            y: (parent.height - 76px) / 2 + 40px;
            width: parent.width - 24px;
            height: 30px;
            text: root.empty-text;
            color: Palette.secondary;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    // Ссылка на параметры.
    Rectangle {
        x: 12px;
        y: 80px + root.body-h + 8px;
        width: parent.width - 24px;
        height: 44px;
        border-radius: 18px;
        background: set-area.pressed ? #ffffff2e : set-area.has-hover ? #ffffff22 : #ffffff14;
        border-width: root.keyboard-focus == (root.has-rows ? root.rows.length : 0) + 2 ? 2px : 0px;
        border-color: white;
        animate background { duration: Palette.animations-enabled ? 110ms : 0ms; easing: ease-out; }

        Glyph {
            size: 18px;
            tint: Palette.text;
            commands: Icons.gear;
            x: 16px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            x: 46px;
            width: parent.width - 46px - 40px;
            height: parent.height;
            text: root.footer-text;
            color: Palette.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Glyph {
            size: 14px;
            tint: Palette.secondary;
            commands: Icons.chevron-right;
            x: parent.width - self.width - 16px;
            y: (parent.height - self.height) / 2;
        }

        set-area := TouchArea {
            clicked => {
                root.settings();
            }
        }
    }
}
