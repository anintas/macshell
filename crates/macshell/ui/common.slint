// Одна палитра: белый на тёмном стекле и один акцент (выбранная строка и курсор).
export global Palette {
    in-out property <bool> animations-enabled: true;
    out property <color> text: #ffffffeb;
    out property <color> secondary: #ffffff8f;
    out property <color> hairline: #ffffff1a;
    /// Цвет системы: Rust ставит его при создании окна (`accent` в конфиге); остальные оттенки считаются от него.
    in-out property <color> accent: #4673e2;
    out property <color> accent-top: root.accent.brighter(0.12);
    out property <color> accent-bottom: root.accent.darker(0.1);
    out property <color> caret: root.accent.mix(#ffffff, 0.62);
}

export component Glyph inherits Path {
    in property <length> size: 20px;
    in property <brush> tint: white;
    width: root.size;
    height: root.size;
    viewbox-width: 256;
    viewbox-height: 256;
    fill: root.tint;
    fill-rule: FillRule.evenodd;
}

/// Значок-заглушка, когда система не отдала картинку (как общий значок приложения в macOS): контур окна
/// со строкой заголовка. Без неё плитка или место на панели оставались пустыми.
export component AppPlaceholder inherits Rectangle {
    in property <length> size: 24px;
    in property <brush> tint: Palette.secondary;
    width: root.size;
    height: root.size;

    frame := Rectangle {
        x: root.size * 0.08;
        y: root.size * 0.17;
        width: root.size * 0.84;
        height: root.size * 0.66;
        border-radius: root.size * 0.14;
        border-width: max(1px, root.size * 0.07);
        border-color: root.tint;

        Rectangle {
            x: 0px;
            y: frame.height * 0.3;
            width: frame.width;
            height: max(1px, root.size * 0.06);
            background: root.tint;
        }
    }
}

/// Значок трея: картинка из значка приложения, подсказка и признак «вынесен на панель».
export struct TrayItem {
    /// Значок остался в родном трее: живого значка и родного меню нет, плитка приглушена.
    limited: bool,
    name: string,
    icon: image,
    tip: string,
    pinned: bool,
    /// Значок убран из окна; виден только в режиме «показать скрытые» и приглушён.
    hidden: bool,
}
